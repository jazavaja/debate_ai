# نمونه فایل ENV برای تنظیمات LLM و وب‌سرویس

# Provider: openai, anthropic، یا هر نام دلخواه برای سرویس سفارشی
LLM_PROVIDER=openai
LLM_MODEL=MiniMaxAI/MiniMax-M2.7
LLM_API_KEY=dahl_Nm5Ruhz82X3CNRac5C4XeztPjtVWeBV5C
LLM_BASE_URI=https://inference.dahl.global/v1
LLM_AUTH_HEADER_NAME=Authorization
LLM_AUTH_TOKEN_PREFIX=Bearer 
LLM_API_PATH=/chat/completions
LLM_TEMPERATURE=0.8

# اگر می‌خواهید از متغیرهای مخصوص OpenAI استفاده کنید:
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URI=https://api.openai.com/v1

# مثال برای OpenRouter:
# LLM_PROVIDER=openai
# LLM_BASE_URI=https://openrouter.ai/v1
# LLM_MODEL=gpt-4o-mini
# LLM_AUTH_HEADER_NAME=Authorization
# LLM_AUTH_TOKEN_PREFIX=Bearer 

# مثال برای سرویس‌های سفارشی که کلید در هدر Authorization ارسال می‌شود:
# LLM_PROVIDER=custom
# LLM_BASE_URI=https://your-service.example.com
# LLM_AUTH_HEADER_NAME=Authorization
# LLM_AUTH_TOKEN_PREFIX=Bearer 
